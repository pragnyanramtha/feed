# Notion — internal integration token + the three database IDs
# from: python -m scripts.bootstrap_notion
NOTION_API_KEY=secret_YOUR_KEY_HERE
NOTION_PARENT_PAGE_ID=YOUR_PAGE_ID_HERE
NOTION_NOTICES_DB_ID=
NOTION_INBOX_DB_ID=
NOTION_RUN_LOG_DB_ID=

# Optional. If unset, ingest still runs in dry-run (prints JSON, writes nothing).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta). Test number is enough for the hackathon.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=campus-notice-desk
# WHATSAPP_APP_SECRET=
# WHATSAPP_DEFAULT_TO=

# Outbound email fallback (Resend). Still a real-world action if WA templates stall.
# RESEND_API_KEY=
# RESEND_FROM=notices@yourdomain.com
# NOTICE_EMAIL_TO=you@college.edu

# Notion webhook verification token (pasted from the integration UI after first ping)
# NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Comma-separated phones in E.164 for the class digest (test list)
# DIGEST_WHATSAPP_TO=9198XXXXXXXX
